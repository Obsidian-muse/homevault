# PostgreSQL connection string (Prisma)
# e.g. postgresql://USER:PASSWORD@HOST:5432/homevault?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homevault?schema=public"

# Auth.js v5 (next-auth)
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Still supported as a fallback if you already have this set elsewhere.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (image uploads for assets)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
